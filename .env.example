# PostgreSQL credentials
# Copy this file to .env and fill in your values before running docker compose.
POSTGRES_DB=telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=changeme

# Backend database URL (constructed from credentials above)
DATABASE_URL=postgresql://telemetry:changeme@postgres:5432/telemetry

# JWT signing secret — generate a strong random value for production
JWT_SECRET=change-me-to-a-strong-random-secret

# Production only — Docker Hub image to deploy
APP_IMAGE=your-dockerhub-username/simulated-aircraft-telemetry-system:latest
