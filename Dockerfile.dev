# ============================
# DEV IMAGE (no builds inside)
# ============================
FROM ubuntu:24.04

# Install system deps: Node 24, Renode, NestJS CLI
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    software-properties-common \
    python3 \
    mono-complete \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Node 24
RUN wget -qO- https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs

# Install Renode 1.16.1
RUN wget -q https://github.com/renode/renode/releases/download/v1.16.1/renode_1.16.1_amd64.deb -O /tmp/renode.deb && \
    apt-get update && apt-get install -y mono-complete python3 unzip && \
    dpkg -i /tmp/renode.deb || apt-get -f install -y

# Install global tools
RUN npm install -g @nestjs/cli

# Install backend deps
WORKDIR /app/backend
COPY backend/package*.json ./
COPY backend/prisma ./prisma
COPY backend/prisma.config.ts ./
RUN npm install

# Install frontend deps
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm install

# Keep node_modules available when the app source is mounted
VOLUME ["/app/backend/node_modules", "/app/frontend/node_modules"]

# Expose dev ports
EXPOSE 3000
EXPOSE 4200
EXPOSE 4321

# Default command does nothing — docker-compose will override
CMD ["bash"]
